# 复制为 .env 作为本地默认配置；本机覆盖写入 .env.local。
# pnpm dev / pnpm migrate 依次加载 .env、.env.local（后者覆盖前者），进程环境变量优先于文件。
# 部署时由平台注入同名环境变量，pnpm start 不加载文件。

# 数据库连接串（必填）
DATABASE_URL=postgres://worldbook:worldbook@127.0.0.1:5432/worldbook

# 模型：使用预置时填 MODEL_PRESET 与对应供应商的 key。
# 预置见 packages/model/src/presets.ts：deepseek / gpt / glm。
MODEL_PRESET=deepseek
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ZHIPUAI_API_KEY=

# MODEL_NAME 可覆盖预置默认模型；不用预置时改填下面三项（MODEL_NAME 必填）。
# MODEL_NAME=
# MODEL_BASE_URL=
# MODEL_API_KEY=

# HTTP 端口（可选，默认 3000）
# HTTP_PORT=3000

# 进程内容器上限（可选）：turn 终态快照 / 会话 seq 计数器 / 单订阅未消费帧
# TURN_STATE_MAX_ENTRIES=100000
# SESSION_COUNTER_MAX_ENTRIES=100000
# SINK_MAX_BUFFERED_FRAMES=1024
